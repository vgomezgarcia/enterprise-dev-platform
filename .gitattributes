# Default text handling
* text=auto

# Linux / AWS files must use LF
*.sh   text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Web files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Documentation
*.md   text eol=lf

# Windows-specific scripts
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf